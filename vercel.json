{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/embed",
      "destination": "/index.html"
    },
    {
      "source": "/embed/",
      "destination": "/index.html"
    },
    {
      "source": "/de/embed",
      "destination": "/index.html"
    },
    {
      "source": "/fr/embed",
      "destination": "/index.html"
    },
    {
      "source": "/es/embed",
      "destination": "/index.html"
    },
    {
      "source": "/it/embed",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api"
    },
    {
      "source": "/report/(.*)",
      "destination": "/api"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "/api"
    },
    {
      "source": "/open/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/history",
      "destination": "/index.html"
    },
    {
      "source": "/html-to-markdown",
      "destination": "/index.html"
    },
    {
      "source": "/word-to-markdown",
      "destination": "/index.html"
    },
    {
      "source": "/csv-to-markdown",
      "destination": "/index.html"
    },
    {
      "source": "/json-to-markdown",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/index.html"
    },
    {
      "source": "/history/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!embed$|embed/|(?:de|fr|es|it)/embed).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/embed/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/de/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fr/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/es/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/it/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api"
    },
    {
      "source": "/report/(.*)",
      "destination": "/api"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "/api"
    },
    {
      "source": "/open/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/history",
      "destination": "/index.html"
    },
    {
      "source": "/html-to-markdown",
      "destination": "/index.html"
    },
    {
      "source": "/word-to-markdown",
      "destination": "/index.html"
    },
    {
      "source": "/csv-to-markdown",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/index.html"
    },
    {
      "source": "/history/",
      "destination": "/index.html"
    }
  ]
}

# Neon Postgres connection string (Neon console -> Connection string -> pooled).
# The same database also holds Neon Auth's `neon_auth` schema.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Auth endpoint for the project (Neon console -> Auth). Sign-in, sign-out and the session
# read are proxied to it through /api/auth/* so its cookie is first-party for this site.
NEON_AUTH_BASE_URL="https://api.stack-auth.neon.tech/api/v1/.../auth"

# Vercel Blob store that holds the Markdown sources (Storage -> the store -> Connect Project).
# Without it the sources stay in the database column, which is what older rows still use.
BLOB_READ_WRITE_TOKEN=""

# Resend, for the notice a named share sends. Absent means the share still works and nobody is told.
RESEND_API_KEY=
MAIL_FROM="TransformPipe <no-reply@transformpipe.com>"

# Neon Postgres connection string (Neon console → Connection string → pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Google OAuth 2.0 Web client ID (Google Cloud console → Credentials).
# Both variables hold the same value: the server verifies ID tokens with
# GOOGLE_CLIENT_ID, the browser renders the sign-in button with the VITE_ one.
GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# Random string, 32+ characters — signs the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
